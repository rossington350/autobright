<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- App-specific colours layered on the template palette (Colors.xaml). -->
    <Color x:Key="PageBgLight">#F3F3F3</Color>
    <Color x:Key="PageBgDark">#141414</Color>
    <Color x:Key="CardBgLight">#FFFFFF</Color>
    <Color x:Key="CardBgDark">#212121</Color>
    <Color x:Key="CardStrokeLight">#E1E1E1</Color>
    <Color x:Key="CardStrokeDark">#383838</Color>
    <Color x:Key="SecondaryTextLight">#6E6E6E</Color>
    <Color x:Key="SecondaryTextDark">#ACACAC</Color>
    <Color x:Key="ListBgLight">#FAFAFA</Color>
    <Color x:Key="ListBgDark">#1A1A1A</Color>
    <Color x:Key="ErrorColor">#E74C3C</Color>

    <!-- A subtle, rounded surface used to group related controls. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="8" />
        </Setter>
    </Style>

    <Style x:Key="SectionHeader" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
        <Setter Property="Margin" Value="2,0,0,2" />
    </Style>

    <Style x:Key="StatCaption" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
    </Style>

    <Style x:Key="StatValue" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="FieldCaption" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
        <Setter Property="Margin" Value="2,0,0,2" />
    </Style>

    <Style x:Key="SecondaryText" TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
    </Style>

</ResourceDictionary>
