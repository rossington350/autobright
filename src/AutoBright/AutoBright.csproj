<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only .NET MAUI app. The hardware this controls (DDC/CI monitor
         brightness, the Yoctopuce USB sensor, the Win32 notification-area icon)
         is Windows-specific, so there is a single Windows target rather than the
         usual MAUI multi-target head set. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AutoBright</RootNamespace>
    <AssemblyName>AutoBright</AssemblyName>

    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Generate C# from XAML at compile time (faster startup than runtime inflation). -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <!-- Display metadata -->
    <ApplicationTitle>AutoBright</ApplicationTitle>
    <ApplicationId>com.autobright.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- WindowsAppSDKSelfContained requires a concrete architecture. Default to
         the host RID when none is supplied so a plain `dotnet build` (or an IDE
         build / F5) works without passing `-r`; `-r win-arm64` still overrides. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <!-- Keep the exe at a predictable bin\<Config>\<TFM>\ path (no win-x64/
         win-arm64 subfolder) so launch configs resolve regardless of host RID. -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Unpackaged (no MSIX) desktop app; self-contain the Windows App SDK so no
         separate runtime install is required. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Yoctopuce.YoctoLib" Version="2.1.11632" />
  </ItemGroup>

  <ItemGroup>
    <!-- Used at runtime for the window title-bar icon and the tray icon. -->
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
