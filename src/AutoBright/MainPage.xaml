<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoBright.MainPage"
             Title="AutoBright"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="16">

            <!-- Header -->
            <HorizontalStackLayout Spacing="12" Margin="2,0,0,0">
                <Border WidthRequest="40" HeightRequest="40" Padding="0"
                        BackgroundColor="{StaticResource Primary}"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label Text="&#x2600;" FontSize="20" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="AutoBright" FontSize="20" FontAttributes="Bold" />
                    <Label Text="Ambient-light brightness control" FontSize="13"
                           Style="{StaticResource SecondaryText}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Live readout -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Text="CURRENT LUX" Style="{StaticResource StatCaption}" />
                        <Label x:Name="LuxValue" Text="—" Style="{StaticResource StatValue}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Text="TARGET BRIGHTNESS" Style="{StaticResource StatCaption}" />
                        <Label x:Name="TargetValue" Text="—" Style="{StaticResource StatValue}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Manual override -->
            <VerticalStackLayout Spacing="6">
                <Label Text="MANUAL OVERRIDE" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="ManualCheck" VerticalOptions="Center"
                                      CheckedChanged="OnManualCheckChanged" />
                            <Label Text="Manual brightness control" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <VerticalStackLayout x:Name="ManualPanel" Spacing="14" IsVisible="False">
                            <HorizontalStackLayout Spacing="8">
                                <CheckBox x:Name="AbsoluteCheck" VerticalOptions="Center"
                                          CheckedChanged="OnAbsoluteChanged" />
                                <Label Text="Use absolute 0–100% range (ignore configured min/max)"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="20">
                                <RadioButton x:Name="MinRadio" Content="Min"
                                             GroupName="ManualMode" CheckedChanged="OnManualModeChanged" />
                                <RadioButton x:Name="MaxRadio" Content="Max"
                                             GroupName="ManualMode" CheckedChanged="OnManualModeChanged" />
                                <RadioButton x:Name="ManualRadio" Content="Manual"
                                             GroupName="ManualMode" CheckedChanged="OnManualModeChanged" />
                            </HorizontalStackLayout>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Slider x:Name="ManualSlider" Grid.Column="0"
                                        Minimum="0" Maximum="100"
                                        ValueChanged="OnManualSliderChanged"
                                        VerticalOptions="Center" />
                                <Label x:Name="ManualValueLabel" Grid.Column="1" Text="50%"
                                       WidthRequest="44" HorizontalTextAlignment="End"
                                       FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Settings -->
            <VerticalStackLayout Spacing="6">
                <Label Text="SETTINGS" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="12" RowSpacing="14">

                            <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                <Label Text="Min lux" Style="{StaticResource FieldCaption}" />
                                <Entry x:Name="MinLuxBox" Keyboard="Numeric"
                                       Completed="OnSettingCompleted" Unfocused="OnSettingCommitted" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                                <Label Text="Max lux" Style="{StaticResource FieldCaption}" />
                                <Entry x:Name="MaxLuxBox" Keyboard="Numeric"
                                       Completed="OnSettingCompleted" Unfocused="OnSettingCommitted" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                                <Label Text="Min brightness (%)" Style="{StaticResource FieldCaption}" />
                                <Entry x:Name="MinBrightnessBox" Keyboard="Numeric"
                                       Completed="OnSettingCompleted" Unfocused="OnSettingCommitted" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                <Label Text="Max brightness (%)" Style="{StaticResource FieldCaption}" />
                                <Entry x:Name="MaxBrightnessBox" Keyboard="Numeric"
                                       Completed="OnSettingCompleted" Unfocused="OnSettingCommitted" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="2" Grid.Column="0">
                                <Label Text="Update rate (s)" Style="{StaticResource FieldCaption}" />
                                <Entry x:Name="IntervalBox" Keyboard="Numeric"
                                       Completed="OnSettingCompleted" Unfocused="OnSettingCommitted" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                                <Label Text="Max change rate (%/s)" Style="{StaticResource FieldCaption}" />
                                <Entry x:Name="MaxRateBox" Keyboard="Numeric"
                                       Completed="OnSettingCompleted" Unfocused="OnSettingCommitted" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="3" Grid.Column="0">
                                <Label Text="Lux hysteresis" Style="{StaticResource FieldCaption}" />
                                <Entry x:Name="HysteresisBox" Keyboard="Numeric"
                                       Completed="OnSettingCompleted" Unfocused="OnSettingCommitted" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="TrayCheck" VerticalOptions="Center"
                                      CheckedChanged="OnSettingCommitted" />
                            <Label Text="Minimize to tray on close" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="RunAtStartupCheck" VerticalOptions="Center"
                                      CheckedChanged="OnSettingCommitted" />
                            <Label Text="Run at Windows startup" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="StartMinimizedCheck" VerticalOptions="Center"
                                      CheckedChanged="OnSettingCommitted" />
                            <Label Text="Start minimized to tray" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label x:Name="SettingsStatus" Text="" IsVisible="False"
                               Style="{StaticResource SecondaryText}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Monitors -->
            <VerticalStackLayout Spacing="6">
                <Label Text="MONITORS" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="WorkerStatus" Text="Starting…"
                               Style="{StaticResource SecondaryText}" />

                        <Border Padding="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource ListBgLight}, Dark={StaticResource ListBgDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                            <CollectionView x:Name="MonitorList" HeightRequest="180">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding .}" FontFamily="Consolas" FontSize="13"
                                               Padding="10,2" LineBreakMode="TailTruncation" />
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>

                        <HorizontalStackLayout Spacing="8">
                            <Button x:Name="RefreshButton" Text="Refresh monitors" Clicked="OnRefreshClick" />
                            <Button x:Name="ReconnectButton" Text="Reconnect sensor" Clicked="OnReconnectClick"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    BorderColor="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                                    BorderWidth="1" />
                            <Button x:Name="HideButton" Text="Hide to tray" Clicked="OnHideClick"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    BorderColor="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                                    BorderWidth="1" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
