<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AutoBright.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Brightness Dimmer">

    <ScrollViewer Padding="12">
        <StackPanel Spacing="6" MinWidth="420">

            <Grid ColumnSpacing="8" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Min lux:" VerticalAlignment="Center" />
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="MinLuxBox" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Max lux:" VerticalAlignment="Center" />
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="MaxLuxBox" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Min brightness (%):" VerticalAlignment="Center" />
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="MinBrightnessBox" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Max brightness (%):" VerticalAlignment="Center" />
                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="MaxBrightnessBox" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Update rate (s):" VerticalAlignment="Center" />
                <TextBox   Grid.Row="4" Grid.Column="1" x:Name="IntervalBox" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Max change rate (%/s):" VerticalAlignment="Center" />
                <TextBox   Grid.Row="5" Grid.Column="1" x:Name="MaxRateBox" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Lux hysteresis:" VerticalAlignment="Center" />
                <TextBox   Grid.Row="6" Grid.Column="1" x:Name="HysteresisBox" />
            </Grid>

            <CheckBox x:Name="TrayCheck" Content="Minimize to tray on close" />

            <Button x:Name="ApplyButton" Content="Apply" HorizontalAlignment="Stretch" Click="OnApplyClick" />

            <TextBlock x:Name="LuxLabel" Text="Current lux: ?" />
            <TextBlock x:Name="TargetLabel" Text="Target brightness: ?" />

            <ListView x:Name="MonitorList" Height="200"
                      SelectionMode="None" IsItemClickEnabled="False"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollMode="Enabled"
                      BorderThickness="1" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RefreshButton" Content="Refresh monitors" Click="OnRefreshClick" />
                <Button x:Name="ReconnectButton" Content="Reconnect sensor" Click="OnReconnectClick" />
                <Button x:Name="HideButton" Content="Hide to tray" Click="OnHideClick" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
