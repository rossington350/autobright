<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AutoBright.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AutoBright">

    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>

            <!-- A subtle, rounded surface used to group related controls. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="Margin" Value="2,0,0,2" />
            </Style>

            <Style x:Key="StatCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>

        <ScrollViewer Padding="20"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16" MinWidth="360" HorizontalAlignment="Stretch">

                <!-- Header -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="2,0,0,0">
                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE706;" FontSize="20"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AutoBright" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Ambient-light brightness control"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Live readout -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="CURRENT LUX" Style="{StaticResource StatCaption}" />
                            <TextBlock x:Name="LuxValue" Text="—" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="TARGET BRIGHTNESS" Style="{StaticResource StatCaption}" />
                            <TextBlock x:Name="TargetValue" Text="—" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Manual override -->
                <StackPanel Spacing="6">
                    <TextBlock Text="MANUAL OVERRIDE" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="12">
                            <CheckBox x:Name="ManualCheck" Content="Manual brightness control"
                                      Checked="OnManualCheckChanged" Unchecked="OnManualCheckChanged" />

                            <StackPanel x:Name="ManualPanel" Spacing="14" Visibility="Collapsed">
                                <CheckBox x:Name="AbsoluteCheck"
                                          Content="Use absolute 0–100% range (ignore configured min/max)"
                                          Checked="OnAbsoluteChanged" Unchecked="OnAbsoluteChanged" />

                                <StackPanel Orientation="Horizontal" Spacing="20">
                                    <RadioButton x:Name="MinRadio" Content="Min"
                                                 GroupName="ManualMode" Checked="OnManualModeChanged" />
                                    <RadioButton x:Name="MaxRadio" Content="Max"
                                                 GroupName="ManualMode" Checked="OnManualModeChanged" />
                                    <RadioButton x:Name="ManualRadio" Content="Manual"
                                                 GroupName="ManualMode" Checked="OnManualModeChanged" />
                                </StackPanel>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="ManualSlider" Grid.Column="0"
                                            Minimum="0" Maximum="100" StepFrequency="1"
                                            ValueChanged="OnManualSliderChanged"
                                            VerticalAlignment="Center" />
                                    <TextBlock x:Name="ManualValueLabel" Grid.Column="1" Text="50%"
                                               MinWidth="44" TextAlignment="Right"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Settings -->
                <StackPanel Spacing="6">
                    <TextBlock Text="SETTINGS" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="12" RowSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" Grid.Column="0" Header="Min lux"
                                         x:Name="MinLuxBox" LostFocus="OnSettingCommitted" KeyDown="OnSettingKeyDown" />
                                <TextBox Grid.Row="0" Grid.Column="1" Header="Max lux"
                                         x:Name="MaxLuxBox" LostFocus="OnSettingCommitted" KeyDown="OnSettingKeyDown" />

                                <TextBox Grid.Row="1" Grid.Column="0" Header="Min brightness (%)"
                                         x:Name="MinBrightnessBox" LostFocus="OnSettingCommitted" KeyDown="OnSettingKeyDown" />
                                <TextBox Grid.Row="1" Grid.Column="1" Header="Max brightness (%)"
                                         x:Name="MaxBrightnessBox" LostFocus="OnSettingCommitted" KeyDown="OnSettingKeyDown" />

                                <TextBox Grid.Row="2" Grid.Column="0" Header="Update rate (s)"
                                         x:Name="IntervalBox" LostFocus="OnSettingCommitted" KeyDown="OnSettingKeyDown" />
                                <TextBox Grid.Row="2" Grid.Column="1" Header="Max change rate (%/s)"
                                         x:Name="MaxRateBox" LostFocus="OnSettingCommitted" KeyDown="OnSettingKeyDown" />

                                <TextBox Grid.Row="3" Grid.Column="0" Header="Lux hysteresis"
                                         x:Name="HysteresisBox" LostFocus="OnSettingCommitted" KeyDown="OnSettingKeyDown" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <CheckBox x:Name="TrayCheck" Content="Minimize to tray on close"
                                      Checked="OnSettingCommitted" Unchecked="OnSettingCommitted" />

                            <TextBlock x:Name="SettingsStatus" Text=""
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Monitors -->
                <StackPanel Spacing="6">
                    <TextBlock Text="MONITORS" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="WorkerStatus" Text="Starting…"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <ListView x:Name="MonitorList" Height="180"
                                      Padding="0"
                                      SelectionMode="None" IsItemClickEnabled="False"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollMode="Enabled"
                                      FontFamily="Consolas" FontSize="13"
                                      Background="{ThemeResource ControlFillColorDefaultBrush}"
                                      BorderThickness="1"
                                      CornerRadius="6"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="RefreshButton" Content="Refresh monitors"
                                        Style="{ThemeResource AccentButtonStyle}" Click="OnRefreshClick" />
                                <Button x:Name="ReconnectButton" Content="Reconnect sensor" Click="OnReconnectClick" />
                                <Button x:Name="HideButton" Content="Hide to tray" Click="OnHideClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
